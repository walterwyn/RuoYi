<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.perf.mapper.PerfIndicatorMapper">

	<resultMap type="PerfIndicator" id="PerfIndicatorResult">
		<id     property="indicatorId"      column="indicator_id"      />
		<result property="indicatorName"    column="indicator_name"    />
		<result property="indicatorType"    column="indicator_type"    />
		<result property="scoringStandard"  column="scoring_standard"  />
		<result property="orderNum"         column="order_num"         />
		<result property="status"           column="status"            />
		<result property="createBy"         column="create_by"         />
		<result property="createTime"       column="create_time"       />
		<result property="updateBy"         column="update_by"         />
		<result property="updateTime"       column="update_time"       />
		<result property="remark"           column="remark"            />
	</resultMap>

	<sql id="selectIndicatorVo">
		select indicator_id, indicator_name, indicator_type, scoring_standard, order_num, status, create_by, create_time, update_by, update_time, remark
		from perf_indicator
	</sql>

	<select id="selectIndicatorList" parameterType="PerfIndicator" resultMap="PerfIndicatorResult">
		<include refid="selectIndicatorVo"/>
		<where>
			<if test="indicatorName != null and indicatorName != ''">
				AND indicator_name like concat('%', #{indicatorName}, '%')
			</if>
			<if test="indicatorType != null and indicatorType != ''">
				AND indicator_type = #{indicatorType}
			</if>
			<if test="status != null and status != ''">
				AND status = #{status}
			</if>
		</where>
		order by order_num, indicator_id
	</select>

	<select id="selectIndicatorById" parameterType="Long" resultMap="PerfIndicatorResult">
		<include refid="selectIndicatorVo"/>
		where indicator_id = #{indicatorId}
	</select>

	<select id="checkIndicatorNameUnique" parameterType="String" resultMap="PerfIndicatorResult">
		<include refid="selectIndicatorVo"/>
		where indicator_name = #{indicatorName} limit 1
	</select>

	<select id="countTemplateItemByIndicatorIds" resultType="int">
		select count(1) from perf_template_item where indicator_id in
		<foreach collection="array" item="indicatorId" open="(" separator="," close=")">
			#{indicatorId}
		</foreach>
	</select>

	<insert id="insertIndicator" parameterType="PerfIndicator" useGeneratedKeys="true" keyProperty="indicatorId">
		insert into perf_indicator(
			<if test="indicatorName != null and indicatorName != ''">indicator_name,</if>
			<if test="indicatorType != null and indicatorType != ''">indicator_type,</if>
			<if test="scoringStandard != null">scoring_standard,</if>
			<if test="orderNum != null">order_num,</if>
			<if test="status != null and status != ''">status,</if>
			<if test="remark != null and remark != ''">remark,</if>
			<if test="createBy != null and createBy != ''">create_by,</if>
			create_time
		)values(
			<if test="indicatorName != null and indicatorName != ''">#{indicatorName},</if>
			<if test="indicatorType != null and indicatorType != ''">#{indicatorType},</if>
			<if test="scoringStandard != null">#{scoringStandard},</if>
			<if test="orderNum != null">#{orderNum},</if>
			<if test="status != null and status != ''">#{status},</if>
			<if test="remark != null and remark != ''">#{remark},</if>
			<if test="createBy != null and createBy != ''">#{createBy},</if>
			sysdate()
		)
	</insert>

	<update id="updateIndicator" parameterType="PerfIndicator">
		update perf_indicator
		<set>
			<if test="indicatorName != null and indicatorName != ''">indicator_name = #{indicatorName},</if>
			<if test="indicatorType != null and indicatorType != ''">indicator_type = #{indicatorType},</if>
			<if test="scoringStandard != null">scoring_standard = #{scoringStandard},</if>
			<if test="orderNum != null">order_num = #{orderNum},</if>
			<if test="status != null and status != ''">status = #{status},</if>
			<if test="remark != null">remark = #{remark},</if>
			<if test="updateBy != null and updateBy != ''">update_by = #{updateBy},</if>
			update_time = sysdate()
		</set>
		where indicator_id = #{indicatorId}
	</update>

	<delete id="deleteIndicatorByIds" parameterType="Long">
		delete from perf_indicator where indicator_id in
		<foreach collection="array" item="indicatorId" open="(" separator="," close=")">
			#{indicatorId}
		</foreach>
	</delete>

</mapper>
